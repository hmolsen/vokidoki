# Der Datenordner des lokalen Servers: config.php (Zugangsdaten) und
# storage/ (Sitzungen, Fehlerprotokoll, Symbole). Die Vorlage dafuer liegt in
# daten-vorlage/ und ist versioniert.
/daten/

# Abhaengigkeiten: composer.json liegt in app/, composer install legt sie nach
# app/vendor/ - auf dem Server per SSH, lokal mit php composer.phar -d app
# install. composer.lock wird bewusst mitversioniert, damit dort dieselben
# Versionen landen.
/app/vendor/
/composer.phar

.DS_Store
Thumbs.db
.idea/

# Bildschirmfotos der Browser-Suite, falls ein Ordner angegeben wird
/tests/browser/bilder/
