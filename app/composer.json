{
    "name": "hannesmolsen/vokabeltrainer",
    "description": "Vokabeltrainer-PWA mit KI-gestuetzter Vokabelerkennung",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "anthropic-ai/sdk": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
