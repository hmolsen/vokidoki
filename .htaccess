# Vokabeltrainer - Basis-Haertung

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Verzeichnisse mit Servercode / Daten komplett sperren
  RewriteRule ^(lib|storage|vendor|tests)/ - [F,L]
  # Falls das Repository versehentlich mit hochgeladen wurde.
  RewriteRule ^\.git - [F,L]
</IfModule>

<FilesMatch "^(config\.php|schema\.sql|composer\.(json|lock)|deploy\.sh|\.gitignore)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  # Module und Stile immer gegenpruefen lassen.
  #
  # Nur app.js traegt einen Versionsstempel in der Adresse; core.js und die
  # Ansichten werden ohne importiert. Ohne diese Zeile entscheidet der Browser
  # nach eigenem Gutduenken, wie lange er eine Datei fuer frisch haelt - und
  # eine alte core.js neben einer neuen app.js laesst die App weiss bleiben.
  # "no-cache" verbietet das Aufheben nicht, es erzwingt nur die Rueckfrage;
  # unveraendert kostet sie ein 304 ohne Rumpf.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Schriften dagegen aendern sich nie - sie tragen ihren Namen und ihren
  # Schnitt in sich. Ein Jahr aufheben spart bei jedem Start die 90 KB, die
  # Fredoka und Nunito zusammen ausmachen.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>
